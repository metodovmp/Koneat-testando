<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <title>Koneat Lite — Acesso</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #000;
      --white: #f7f7f7;
      --muted: #a3a3a8;
      --line: #414145;
      --field: #050505;
      --danger: #ff8585;
      --success: #8ee0b1;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: var(--bg); }
    body {
      min-height: 100svh;
      color: var(--white);
      font-family: Inter, Roboto, "Segoe UI", Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    button, input { font: inherit; }
    button { cursor: pointer; }
    .app {
      width: 100%;
      min-height: 100svh;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      isolation: isolate;
    }
    .screen {
      display: none;
      width: 100%;
      flex: 1;
      min-height: 100svh;
      position: relative;
      padding: max(30px, env(safe-area-inset-top)) 8.1% 100px;
      animation: appear .18s ease-out;
    }
    .screen.active { display: flex; flex-direction: column; }
    @keyframes appear { from { opacity: .45; } to { opacity: 1; } }

    /* LOGIN */
    #loginScreen { justify-content: center; padding-top: 90px; padding-bottom: 110px; }
    .login-decoration {
      position: absolute; z-index: -1; width: 330px; height: 330px;
      border-radius: 50%; border: 1px solid rgba(255,255,255,.075);
      background: radial-gradient(circle at 35% 35%, rgba(255,255,255,.065), transparent 68%);
      pointer-events: none;
    }
    .login-decoration.top { width: 390px; height: 390px; top: -250px; left: -110px; }
    .login-decoration.bottom { width: 350px; height: 350px; bottom: -265px; right: -190px; }
    .brand { text-align: center; margin: 0 0 38px; }
    .brand-name { font-size: clamp(28px, 7vw, 38px); line-height: 1; font-weight: 800; letter-spacing: 1.2px; }
    .brand-tag { margin-top: 17px; color: #aaa; font-size: 14px; letter-spacing: 6px; }
    .form-area { width: 100%; max-width: 560px; margin: 0 auto; }
    .field { display: block; margin-bottom: 27px; }
    .field-label { display: block; font-size: 16px; font-weight: 600; margin: 0 0 12px 1px; }
    .input-wrap { position: relative; }
    .field input:not(.code-input), .code-input {
      width: 100%; height: 59px; border: 1px solid var(--line); border-radius: 999px;
      color: var(--white); background: var(--field); outline: none;
      padding: 0 20px; font-size: 16px; transition: border-color .16s, box-shadow .16s;
    }
    .field input::placeholder, .code-input::placeholder { color: #85858b; opacity: 1; }
    .field input:not(.code-input):focus, .code-input:focus { border-color: #bdbdc2; box-shadow: 0 0 0 2px rgba(255,255,255,.07); }
    .has-toggle input { padding-right: 60px; }
    .eye {
      position: absolute; top: 50%; right: 14px; transform: translateY(-50%);
      width: 38px; height: 38px; display: grid; place-items: center;
      border: 0; color: #bfc0c5; background: transparent; padding: 4px;
    }
    .eye svg { width: 25px; height: 25px; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .primary {
      width: 100%; min-height: 59px; border: 0; border-radius: 999px;
      background: #fff; color: #050505; font-weight: 750; font-size: 17px;
      display: flex; align-items: center; justify-content: center; gap: 15px;
      margin-top: 8px; transition: transform .15s, background .15s;
    }
    .primary:active { transform: scale(.985); background: #e7e7e7; }
    .arrow { font-size: 27px; line-height: .7; font-weight: 400; }
    .divider {
      display: flex; align-items: center; gap: 14px; color: #aaa;
      margin: 25px 0 27px; font-size: 16px;
    }
    .divider::before, .divider::after { content: ""; height: 1px; flex: 1; background: #555; }
    .google {
      min-height: 59px; width: 100%; border: 1px solid var(--line); border-radius: 999px;
      background: transparent; color: #f2f2f2; display: flex; align-items: center;
      justify-content: center; gap: 18px; font-size: 16px;
    }
    .google-mark { font-size: 26px; font-weight: 800; color: #4285f4; }
    .google-separator { height: 28px; width: 1px; background: #555; }
    .login-links { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 13px; margin-top: 37px; }
    .text-link {
      padding: 2px 0; border: 0; background: transparent; color: #aaa;
      text-decoration: underline; text-underline-offset: 5px; font-size: 15px;
    }
    .dot { color: #aaa; }

    /* TELAS INTERNAS */
    .back {
      align-self: flex-start; display: inline-flex; align-items: center; gap: 12px;
      margin: 20px 0 0; padding: 4px 0; border: 0; background: transparent;
      color: #eee; font-size: 15px;
    }
    .back-arrow { font-size: 30px; line-height: .7; font-weight: 300; }
    .content { width: 100%; max-width: 560px; margin: auto; padding: 40px 0 25px; }
    .heading { text-align: center; margin: 0 0 64px; }
    .heading h1 { margin: 0 0 12px; font-size: clamp(23px, 6vw, 31px); line-height: 1.2; font-weight: 750; }
    .heading p { margin: 0; color: #c1c1c6; font-size: 16px; line-height: 1.5; }
    .internal-fields .field { margin-bottom: 31px; }
    .internal-fields .field-label { font-size: 16px; margin-bottom: 12px; }
    .internal-fields .field input { height: 57px; }
    .rule { height: 1px; width: 100%; background: #555; margin: 24px 0; }
    .recovery-shortcut { text-align: center; color: #ddd; font-size: 15px; line-height: 1.7; }
    .recovery-shortcut .text-link { color: #eee; margin-left: 7px; font-size: 15px; }
    .code-content .heading { margin-bottom: 65px; }
    .code-input {
      height: 58px; border: 0; border-bottom: 2px solid #eee; border-radius: 0;
      padding: 0 8px; background: transparent; font-size: 20px; letter-spacing: 7px;
    }
    .code-input:focus { border-color: #fff; box-shadow: none; }
    .code-content .primary { margin-top: 65px; }
    .resend { text-align: center; margin: 32px 0 0; color: #c4c4ca; font-size: 15px; line-height: 1.6; }
    .resend .text-link { color: #eee; font-size: 15px; }
    .notice {
      display: none; max-width: 560px; width: 100%; margin: 0 auto 18px;
      padding: 12px 15px; border-radius: 12px; font-size: 14px; line-height: 1.45;
      border: 1px solid transparent;
    }
    .notice.show { display: block; }
    .notice.error { color: var(--danger); border-color: rgba(255,133,133,.35); background: rgba(255,133,133,.08); }
    .notice.success { color: var(--success); border-color: rgba(142,224,177,.3); background: rgba(142,224,177,.07); }
    .footer {
      position: fixed; z-index: 5; bottom: max(22px, env(safe-area-inset-bottom));
      left: 0; width: 100%; text-align: center; color: #aaa;
      font-size: 13px; letter-spacing: .3px; pointer-events: none;
    }
    .prototype-note { color: #777; text-align: center; font-size: 11px; line-height: 1.5; margin: 18px 0 0; }
    @media (min-width: 700px) {
      .screen { padding-left: 24px; padding-right: 24px; }
      #loginScreen { padding-left: 8%; padding-right: 8%; }
      .brand { margin-bottom: 42px; }
      .field input, .primary, .google { min-height: 62px; }
      .field input { height: 62px; }
    }
    @media (max-height: 700px) {
      #loginScreen { justify-content: flex-start; padding-top: 35px; }
      .brand { margin-bottom: 25px; }
      .field { margin-bottom: 18px; }
      .login-links { margin-top: 24px; }
      .content { padding-top: 18px; }
      .heading { margin-bottom: 35px; }
      .code-content .heading { margin-bottom: 35px; }
      .code-content .primary { margin-top: 35px; }
    }
  </style>
</head>
<body>
<div class="app">
  <section class="screen active" id="loginScreen" aria-label="Login">
    <span class="login-decoration top"></span><span class="login-decoration bottom"></span>
    <div class="form-area">
      <header class="brand">
        <div class="brand-name">KONEAT</div>
        <div class="brand-tag">O COMEÇO</div>
      </header>
      <div class="notice" id="noticeLogin" role="status" aria-live="polite"></div>
      <form id="loginForm">
        <label class="field">
          <span class="field-label">E-mail</span>
          <input id="loginEmail" type="email" autocomplete="username" placeholder="Digite seu e-mail" required>
        </label>
        <label class="field">
          <span class="field-label">Senha</span>
          <span class="input-wrap has-toggle">
            <input id="loginPassword" type="password" autocomplete="current-password" placeholder="Digite sua senha" required>
            <button class="eye" type="button" data-toggle="loginPassword" aria-label="Mostrar senha"></button>
          </span>
        </label>
        <button class="primary" type="submit">ENTRAR <span class="arrow">→</span></button>
      </form>
      <div class="divider">Ou</div>
      <button class="google" type="button" id="googleButton">
        <span class="google-mark">G</span><span class="google-separator"></span><span>Continuar com Google</span>
      </button>
      <nav class="login-links">
        <button class="text-link" type="button" data-go="signupScreen">Criar nova conta</button>
        <span class="dot">•</span>
        <button class="text-link" type="button" data-go="recoveryScreen">Recuperar acesso</button>
      </nav>
    </div>
  </section>

  <section class="screen" id="signupScreen" aria-label="Criar nova conta">
    <button class="back" type="button" data-go="loginScreen"><span class="back-arrow">←</span> Voltar ao login</button>
    <div class="content">
      <div class="heading">
        <h1>CRIE SUA CONTA</h1>
        <p>Preencha com seus dados, enviaremos um código para confirmação.</p>
      </div>
      <div class="notice" id="noticeSignup" role="status" aria-live="polite"></div>
      <form id="signupForm" class="internal-fields">
        <label class="field"><span class="field-label">Nome de usuário</span><input id="signupUsername" autocomplete="username" placeholder="Crie um @usuário" required></label>
        <label class="field"><span class="field-label">E-mail</span><input id="signupEmail" type="email" autocomplete="email" placeholder="Digite seu e-mail" required></label>
        <label class="field"><span class="field-label">Número de celular (opcional)</span><input id="signupPhone" type="tel" autocomplete="tel" placeholder="(00) 00000-0000"></label>
        <label class="field"><span class="field-label">Criar nova senha</span><span class="input-wrap has-toggle"><input id="signupPassword" type="password" autocomplete="new-password" minlength="8" placeholder="Crie uma senha (mín. 8 caracteres)" required><button class="eye" type="button" data-toggle="signupPassword" aria-label="Mostrar senha"></button></span></label>
        <button class="primary" type="submit">CONTINUAR <span class="arrow">→</span></button>
      </form>
    </div>
  </section>

  <section class="screen" id="recoveryScreen" aria-label="Recuperar acesso">
    <button class="back" type="button" data-go="loginScreen"><span class="back-arrow">←</span> Voltar ao login</button>
    <div class="content">
      <div class="heading">
        <h1>RECUPERE SEU ACESSO</h1>
        <p>Você receberá um código para confirmar seu e-mail.</p>
      </div>
      <div class="notice" id="noticeRecovery" role="status" aria-live="polite"></div>
      <form id="recoveryForm" class="internal-fields">
        <label class="field"><span class="field-label">E-mail ou Número</span><input id="recoveryIdentity" autocomplete="username" placeholder="E-mail ou número com DDD" required></label>
        <button class="primary" type="submit">ENVIAR CÓDIGO <span class="arrow">→</span></button>
      </form>
      <div class="rule"></div>
      <div class="recovery-shortcut">Deseja alterar sua senha?
        <button class="text-link" type="button" data-go="resetScreen">Redefinir senha</button>
      </div>
    </div>
  </section>

  <section class="screen" id="verifyScreen" aria-label="Verificação de código">
    <button class="back" type="button" id="verifyBack"><span class="back-arrow">←</span> Voltar</button>
    <div class="content code-content">
      <div class="heading">
        <h1 id="verifyTitle">CONFIRME SEU E-MAIL</h1>
        <p id="verifyDescription">Enviaremos um código de confirmação para seu e-mail.</p>
      </div>
      <div class="notice" id="noticeVerify" role="status" aria-live="polite"></div>
      <label class="field">
        <span class="field-label">Digite o código</span>
        <input class="code-input" id="verificationCode" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="Digite o código" aria-label="Código de seis dígitos" required>
      </label>
      <button class="primary" type="button" id="verifyButton">VERIFICAR CÓDIGO</button>
      <p class="resend">Não recebeu nenhum código?
        <button class="text-link" type="button" id="resendCode">Reenviar código</button>
      </p>
      <p class="prototype-note">Protótipo de teste: utilize o código 123456.</p>
    </div>
  </section>

  <section class="screen" id="resetScreen" aria-label="Redefinir senha">
    <button class="back" type="button" id="resetBack"><span class="back-arrow">←</span> Voltar</button>
    <div class="content">
      <div class="heading">
        <h1>REDEFINIR SENHA</h1>
        <p>Informe sua nova senha e confirme para continuar.</p>
      </div>
      <div class="notice" id="noticeReset" role="status" aria-live="polite"></div>
      <form id="resetForm" class="internal-fields">
        <label class="field"><span class="field-label">Nova senha</span><span class="input-wrap has-toggle"><input id="newPassword" type="password" minlength="8" autocomplete="new-password" placeholder="Digite sua nova senha" required><button class="eye" type="button" data-toggle="newPassword" aria-label="Mostrar senha"></button></span></label>
        <label class="field"><span class="field-label">Confirmar nova senha</span><span class="input-wrap has-toggle"><input id="confirmPassword" type="password" autocomplete="new-password" placeholder="Digite novamente sua senha" required><button class="eye" type="button" data-toggle="confirmPassword" aria-label="Mostrar senha"></button></span></label>
        <button class="primary" type="submit">SALVAR SENHA <span class="arrow">→</span></button>
      </form>
      <div class="rule"></div>
      <p class="prototype-note">Demonstração local. Em produção, a redefinição deve exigir uma confirmação de identidade válida.</p>
    </div>
  </section>

  <footer class="footer">© 2027 Systendance.</footer>
</div>

<script>
  const screenIds = ['loginScreen', 'signupScreen', 'recoveryScreen', 'verifyScreen', 'resetScreen'];
  let verificationFlow = 'signup';
  let verificationReturn = 'signupScreen';
  let recoveryReturn = 'recoveryScreen';
  let verificationTarget = '';
  let resendCount = 0;

  function showScreen(id) {
    screenIds.forEach(screenId => {
      document.getElementById(screenId).classList.toggle('active', screenId === id);
    });
    clearNotices();
    window.scrollTo({ top: 0, behavior: 'instant' });
  }
  function showNotice(screen, text, type = 'success') {
    const box = document.getElementById('notice' + screen);
    if (!box) return;
    box.textContent = text;
    box.className = 'notice show ' + type;
  }
  function clearNotices() {
    document.querySelectorAll('.notice').forEach(box => {
      box.textContent = '';
      box.className = 'notice';
    });
  }
  function startVerification(kind, target) {
    verificationFlow = kind;
    verificationReturn = kind === 'signup' ? 'signupScreen' : 'recoveryScreen';
    verificationTarget = target;
    document.getElementById('verifyTitle').textContent =
      kind === 'signup' ? 'CONFIRME SEU E-MAIL' : 'CONFIRME SEU ACESSO';
    document.getElementById('verifyDescription').textContent =
      kind === 'signup'
        ? 'Enviaremos um código de confirmação para ' + target + '.'
        : 'Enviaremos um código de recuperação para ' + target + '.';
    document.getElementById('verificationCode').value = '';
    showScreen('verifyScreen');
    setTimeout(() => document.getElementById('verificationCode').focus(), 80);
  }

  document.querySelectorAll('[data-go]').forEach(button => {
    button.addEventListener('click', () => showScreen(button.dataset.go));
  });

  document.getElementById('loginForm').addEventListener('submit', event => {
    event.preventDefault();
    showNotice('Login', 'Demonstração: conecte o login ao serviço de autenticação para validar a conta.', 'error');
  });
  document.getElementById('googleButton').addEventListener('click', () => {
    showNotice('Login', 'O acesso com Google será ativado quando o OAuth for integrado.', 'error');
  });

  document.getElementById('signupForm').addEventListener('submit', event => {
    event.preventDefault();
    const username = document.getElementById('signupUsername').value.trim();
    const email = document.getElementById('signupEmail').value.trim();
    const password = document.getElementById('signupPassword').value;
    if (username.length < 3) return showNotice('Signup', 'O nome de usuário precisa ter pelo menos 3 caracteres.', 'error');
    if (password.length < 8) return showNotice('Signup', 'Crie uma senha com pelo menos 8 caracteres.', 'error');
    startVerification('signup', email);
  });

  document.getElementById('recoveryForm').addEventListener('submit', event => {
    event.preventDefault();
    const identity = document.getElementById('recoveryIdentity').value.trim();
    startVerification('recovery', identity);
  });

  document.getElementById('verifyBack').addEventListener('click', () => showScreen(verificationReturn));
  document.getElementById('verificationCode').addEventListener('input', event => {
    event.target.value = event.target.value.replace(/\D/g, '').slice(0, 6);
  });
  document.getElementById('resendCode').addEventListener('click', () => {
    resendCount++;
    showNotice('Verify', 'Reenvio demonstrativo solicitado (' + resendCount + '). Nenhum código real foi enviado.', 'success');
  });
  document.getElementById('verifyButton').addEventListener('click', () => {
    const code = document.getElementById('verificationCode').value.trim();
    if (code.length !== 6) return showNotice('Verify', 'Digite os seis números do código.', 'error');
    if (code !== '123456') return showNotice('Verify', 'Código incorreto. No protótipo, utilize 123456.', 'error');
    if (verificationFlow === 'signup') {
      showScreen('loginScreen');
      showNotice('Login', 'Cadastro confirmado no protótipo. Agora você pode testar o acesso.', 'success');
    } else {
      recoveryReturn = 'verifyScreen';
      showScreen('resetScreen');
    }
  });

  document.getElementById('resetBack').addEventListener('click', () => {
    showScreen(verificationFlow === 'recovery' && recoveryReturn === 'verifyScreen' ? 'verifyScreen' : 'recoveryScreen');
  });
  document.getElementById('resetForm').addEventListener('submit', event => {
    event.preventDefault();
    const password = document.getElementById('newPassword').value;
    const confirmation = document.getElementById('confirmPassword').value;
    if (password.length < 8) return showNotice('Reset', 'Use uma senha com pelo menos 8 caracteres.', 'error');
    if (password !== confirmation) return showNotice('Reset', 'As senhas não coincidem.', 'error');
    event.target.reset();
    showScreen('loginScreen');
    showNotice('Login', 'Senha redefinida no protótipo. Nenhuma senha foi salva em um servidor.', 'success');
  });

  document.querySelectorAll('[data-toggle]').forEach(button => {
    const eye = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3.2"/></svg>';
    const hiddenEye = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18M10.6 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15 15 0 0 1-3.1 3.8M6.2 6.3C3.5 8.1 2 12 2 12s3.6 7 10 7c1.5 0 2.8-.4 4-1"/></svg>';
    button.innerHTML = eye;
    button.addEventListener('click', () => {
      const field = document.getElementById(button.dataset.toggle);
      const visible = field.type === 'text';
      field.type = visible ? 'password' : 'text';
      button.innerHTML = visible ? eye : hiddenEye;
      button.setAttribute('aria-label', visible ? 'Mostrar senha' : 'Ocultar senha');
    });
  });
</script>
</body>
</html>
